diff --git a/platform/warp/wmain.c b/platform/warp/wmain.c
index 84e949e2..8a5ff38e 100644
--- a/platform/warp/wmain.c
+++ b/platform/warp/wmain.c
@@ -25,9 +25,32 @@ extern time_t w_start_time;
 jmp_buf w_exit_jump;
 int w_exit_code;
 int w_prof_level;
+int w_check_mode;        /* check=1: fast render paths compared with C */
 static int w_stage = 99;  /* diagnostics: "stage=N" returns after step N */
 uint32_t w_cpu_hz;
 
+/* ITCM of the board (env->fastMem, executable tightly coupled memory):
+ * hot code copied there runs without instruction fetches from the SDRAM. */
+static uint8_t *w_itcm_base;
+static uint32_t w_itcm_size, w_itcm_used;
+
+/* Copies position independent code (no literal pools outside it) to the
+ * ITCM; returns the address to call (Thumb bit set) or NULL. */
+void *w_itcm_code(const void *fn, const void *fn_end)
+{
+    uint32_t start = (uint32_t)fn & ~1u;
+    uint32_t len = ((uint32_t)fn_end - start + 7u) & ~7u;
+    uint8_t *dst;
+
+    if ((w_itcm_base == NULL) || (w_itcm_size - w_itcm_used < len))
+        return NULL;
+    dst = w_itcm_base + w_itcm_used;
+    memcpy(dst, (const void *)start, len);
+    w_itcm_used += len;
+    __asm volatile ("dsb\n isb\n" ::: "memory");
+    return (void *)((uint32_t)dst | 1u);
+}
