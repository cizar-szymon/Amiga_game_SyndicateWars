diff --git a/platform/warp/wfast.c b/platform/warp/wfast.c
new file mode 100644
index 00000000..9afb8976
--- /dev/null
+++ b/platform/warp/wfast.c
@@ -0,0 +1,89 @@
+/* Warp ARM build: game tables copied to the on-chip RAM of the board.
+ * A miss in the SDRAM costs ~146 cycles, in the on-chip RAM a few.
+ *
+ * - the fade table: refreshed whenever the game loads or generates it
+ *   (LB_COLOUR_TABLES_CHANGED in ggenf.c);
+ * - the texture page most used by the faces of the last frame: the faces
+ *   take their page through warp_tmap_page(); at the end of each frame the
+ *   page with most faces is copied (only when it changes). Pages the game
+ *   writes during play (animated textures 4 and 5, the shadow page) are
+ *   never copied; reloading the pages drops the copy. */
+#include <string.h>
+#include "bftypes.h"
+#include "bfgentab.h"
+#include "bflog.h"
+#include "engintxtrmap.h"
+#include "wlibc.h"
+
+extern ushort shadow_tmap_page;
+
+const TbPixel *pixmap_fade_fast;
+static TbPixel *fade_copy;
+static TbBool fade_tried;
+
+void warp_colour_tables_changed(void)
+{
+    if (!fade_tried) {
+        fade_tried = true;
+        fade_copy = (TbPixel *)w_fastmem_alloc(sizeof(pixmap.fade_table));
+        LbWarnLog("fast memory: fade table %u bytes at %p\n",
+          (unsigned)sizeof(pixmap.fade_table), (void *)fade_copy);
+    }
+    if (fade_copy == NULL)
+        return;
+    memcpy(fade_copy, pixmap.fade_table, sizeof(pixmap.fade_table));
+    pixmap_fade_fast = fade_copy;
+}
+
+#define TPAGE_SIZE (VEC_TMAP_WIDTH * VEC_TMAP_HEIGHT)
+
+static ubyte *tpage_copy;
+static TbBool tpage_tried;
+static int tpage_cur = -1;
+static ulong tpage_uses[VEC_TMAP_LIMIT];
+static ulong tpage_changes;
+
+ubyte *warp_tmap_page(int page)
+{
+    tpage_uses[page]++;
+    if (page == tpage_cur)
+        return tpage_copy;
+    return vec_tmap[page];
+}
+
+void warp_tmap_reloaded(void)
+{
+    tpage_cur = -1;
+}
+
+void warp_tmap_frame_end(void)
+{
+    int page, best;
+    ulong best_uses;
+
+    if (!tpage_tried) {
+        tpage_tried = true;
+        tpage_copy = (ubyte *)w_fastmem_alloc(TPAGE_SIZE);
+        LbWarnLog("fast memory: texture page %u bytes at %p\n",
+          (unsigned)TPAGE_SIZE, (void *)tpage_copy);
+    }
+    best = -1;
+    best_uses = 0;
+    for (page = 0; page < VEC_TMAP_LIMIT; page++)
+    {
+        if ((page != 4) && (page != 5) && (page != shadow_tmap_page)
+          && (vec_tmap[page] != NULL) && (tpage_uses[page] > best_uses)) {
+            best = page;
+            best_uses = tpage_uses[page];
+        }
+        tpage_uses[page] = 0;
+    }
+    if ((tpage_copy == NULL) || (best < 0) || (best == tpage_cur))
+        return;
+    memcpy(tpage_copy, vec_tmap[best], TPAGE_SIZE);
+    tpage_cur = best;
+    tpage_changes++;
+    if ((tpage_changes & (tpage_changes - 1)) == 0)
+        LbWarnLog("fast memory: texture page %d copied (%lu changes)\n",
+          best, tpage_changes);
+}
