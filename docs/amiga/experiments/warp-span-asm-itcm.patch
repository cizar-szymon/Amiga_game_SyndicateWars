+    a.s1 = p_inc->S[1];
+    a.s2 = p_inc->S[2];
+    a.s3 = (ubyte)p_inc->S[3];
+    gpoly_span_shaded_get()(o, n, &a);
+    if (gpoly_check_mode_arm < 0)
+        gpoly_check_mode_arm = amiga_check_enabled();
+    if (gpoly_check_mode_arm)
+        gpoly_span_check_arm(o, n, p_bld, p_inc);
+#else
     gpoly_span_shaded_c(o, n, p_bld, p_inc);
 #endif
 }
