+#if defined(SW_WARP) && defined(__arm__)
+/* Warp ARM (Cortex-M7): the shaded span loop in Thumb-2, two pixels per
+ * pass - both texel and fade addresses are formed before their loads, so
+ * the loads do not wait for each other (~13 instructions per pixel instead
+ * of 16). The same carry chain as gpoly_span_shaded_c(): the carry of
+ * b0 + c is dropped, the next add sets it again. */
+struct gp_span_args {
+    const ubyte *map;   /* 0 */
+    const ubyte *fade;  /* 4 */
+    u32 b0, b2, v;      /* 8, 12, 16 */
+    u32 s1, s2, s3;     /* 20, 24, 28 */
+};
+
+__attribute__((naked, noinline))
+static void gpoly_span_shaded_arm(ubyte *o, int n, const struct gp_span_args *a)
+{
+    __asm volatile (
+      "    push   {r4-r11, lr}\n"
+      "    cmp    r1, #0\n"
+      "    ble    3f\n"
+      "    ldr    r3, [r2, #0]\n"       /* map */
+      "    ldr    r4, [r2, #4]\n"       /* fade */
+      "    ldr    r5, [r2, #8]\n"       /* b0 */
+      "    ldr    r6, [r2, #12]\n"      /* b2 */
+      "    ldr    r7, [r2, #16]\n"      /* v */
+      "    ldr    r8, [r2, #20]\n"      /* s1 */
+      "    ldr    r12, [r2, #24]\n"     /* s2 */
+      "    ldr    lr, [r2, #28]\n"      /* s3 */
+      "    subs   r1, r1, #2\n"
+      "    blt    2f\n"
+      "1:\n"
+      "    uxtb   r9, r7\n"             /* pixel A: texel and fade indexes */
+      "    uxtb   r2, r5\n"
+      "    orr    r2, r2, r9, lsl #8\n"
+      "    and    r9, r6, #0xff00\n"
+      "    adds   r6, r6, r8\n"         /* b2 += s1 */
+      "    adc    r5, r5, #0\n"         /* b0 += c */
+      "    adds   r5, r5, r12\n"        /* b0 += s2 */
+      "    adc    r7, r7, lr\n"         /* v += s3 + c */
+      "    uxtb   r11, r7\n"            /* pixel B */
+      "    uxtb   r10, r5\n"
+      "    orr    r10, r10, r11, lsl #8\n"
+      "    and    r11, r6, #0xff00\n"
+      "    adds   r6, r6, r8\n"
+      "    adc    r5, r5, #0\n"
+      "    adds   r5, r5, r12\n"
+      "    adc    r7, r7, lr\n"
+      "    ldrb   r2, [r3, r2]\n"
+      "    ldrb   r10, [r3, r10]\n"
+      "    add    r9, r9, r2\n"
+      "    add    r11, r11, r10\n"
+      "    ldrb   r9, [r4, r9]\n"
+      "    ldrb   r11, [r4, r11]\n"
+      "    strb   r9, [r0], #1\n"
+      "    strb   r11, [r0], #1\n"
+      "    subs   r1, r1, #2\n"
+      "    bge    1b\n"
+      "2:\n"
+      "    adds   r1, r1, #2\n"         /* 0 or 1 pixel left */
+      "    beq    3f\n"
+      "    uxtb   r9, r7\n"
+      "    uxtb   r2, r5\n"
+      "    orr    r2, r2, r9, lsl #8\n"
+      "    and    r9, r6, #0xff00\n"
+      "    ldrb   r2, [r3, r2]\n"
+      "    add    r9, r9, r2\n"
+      "    ldrb   r9, [r4, r9]\n"
+      "    strb   r9, [r0]\n"
+      "3:\n"
+      "    pop    {r4-r11, pc}\n"
+      "    .global gpoly_span_shaded_arm_end\n"
+      "gpoly_span_shaded_arm_end:\n");
+}
+
+extern const char gpoly_span_shaded_arm_end[];
+void *w_itcm_code(const void *fn, const void *fn_end);
+
+typedef void (*gp_span_fn)(ubyte *o, int n, const struct gp_span_args *a);
+static gp_span_fn gpoly_span_shaded_fast;
+
+/* The loop runs from the ITCM when there is room there (no instruction
+ * fetches from the SDRAM), otherwise where it was linked. */
+static gp_span_fn gpoly_span_shaded_get(void)
+{
+    if (gpoly_span_shaded_fast == NULL) {
+        gpoly_span_shaded_fast = (gp_span_fn)w_itcm_code((const void *)gpoly_span_shaded_arm,
+          gpoly_span_shaded_arm_end);
+        LOGWARN("shaded span loop %s", (gpoly_span_shaded_fast != NULL) ? "in ITCM" : "in SDRAM");
+        if (gpoly_span_shaded_fast == NULL)
+            gpoly_span_shaded_fast = gpoly_span_shaded_arm;
+    }
+    return gpoly_span_shaded_fast;
+}
+
+/* Check mode (ENV:SyndWarsCheck exists): every span is also drawn by the C
+ * version into a buffer and compared; differences are logged. */
+static int gpoly_check_mode_arm = -1;
+static unsigned long gpoly_check_spans_arm, gpoly_check_fails_arm;
+
+int amiga_check_enabled(void);
+
+static void gpoly_span_check_arm(ubyte *o, int n, const struct gpoly_blends *p_bld,
+  const struct gpoly_factors *p_inc)
+{
+    static ubyte ref[1024];
+    int i;
+
+    if (n > (int)sizeof(ref))
+        return;
+    gpoly_span_shaded_c(ref, n, p_bld, p_inc);
+    gpoly_check_spans_arm++;
+    for (i = 0; i < n; i++) {
+        if (ref[i] != o[i]) {
+            if (gpoly_check_fails_arm < 20)
+                LOGERR("span %lu (n=%d) differs at %d: asm %d C %d",
+                  gpoly_check_spans_arm, n, i, (int)o[i], (int)ref[i]);
+            gpoly_check_fails_arm++;
+            break;
+        }
+    }
+    if ((gpoly_check_spans_arm & 0xFFFF) == 0)
+        LOGWARN("gpoly check: %lu spans, %lu different", gpoly_check_spans_arm,
+          gpoly_check_fails_arm);
+}
