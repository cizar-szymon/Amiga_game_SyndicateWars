index 84e949e2..71b002fc 100644
--- a/platform/warp/wmain.c
+++ b/platform/warp/wmain.c
@@ -28,6 +28,32 @@ int w_prof_level;
 static int w_stage = 99;  /* diagnostics: "stage=N" returns after step N */
 uint32_t w_cpu_hz;
 
+/* On-chip RAM lent by the firmware (env->fastMem): a miss in the SDRAM costs
+ * ~146 cycles, here a few. Bump allocation, nothing is freed. */
+static WarpExtMem w_fast[WEXT_FASTMEM_MAX];
+static uint32_t w_fast_used[WEXT_FASTMEM_MAX];
+static uint32_t w_fast_count;
+
+/* Data memory (not TCM): the smallest block the size fits in. */
+void *w_fastmem_alloc(uint32_t size)
+{
+    uint32_t i, best = WEXT_FASTMEM_MAX;
+
+    size = (size + 31u) & ~31u;
+    for (i = 0; i < w_fast_count; i++) {
+        if ((w_fast[i].flags & WEXT_MEM_TCM) != 0)
+            continue;
+        if (w_fast[i].size - w_fast_used[i] < size)
+            continue;
+        if ((best == WEXT_FASTMEM_MAX) || (w_fast[i].size < w_fast[best].size))
+            best = i;
+    }
+    if (best == WEXT_FASTMEM_MAX)
+        return NULL;
+    w_fast_used[best] += size;
+    return (uint8_t *)w_fast[best].base + w_fast_used[best] - size;
+}
